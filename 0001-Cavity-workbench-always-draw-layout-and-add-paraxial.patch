+/* ---- element positions along the forward path (geometry only, no eigenmode needed) ---- */
+function geomRec(ops, end){
+  let z=0; const rec={};
+  for(let i=0;i<end;i++){
+    const o=ops[i];
+    if(o.k==='m') rec[o.ei]={z0:z};
+    else if(o.k==='s'){ z+=o.len; if(o.ei>=0 && rec[o.ei]) rec[o.ei].z1=z; }
+  }
+  return {rec, len:z};
+}
+
+/* ---- paraxial ray (y, n*theta) over n round trips; works for unstable cavities too ----
+   Samples carry the unfolded distance zu, the position s on the forward layout path, the travel
+   sign sg along that path, the reflection count (each reflection mirrors the tangential offset)
+   and a nudge (-1 end of a travelled stretch, +1 start of one) so the layout picks the right leg. */
+function traceRay(ops, o){
+  const {fwdEnd, linear, fwdLen, rtLen, plane, y0, u0, n, ap, isMir}=o;
+  const sOf=zr=> linear&&zr>fwdLen ? 2*fwdLen-zr : zr;
+  const sgOf=i=> (!linear||i<fwdEnd) ? 1 : -1;
+  const slab=i=> ops[i].k==='s' && ops[i].len>0;
+  const M=ops.length, nextSg=new Array(M), prevSg=new Array(M);
+  for(let i=0;i<M;i++){
+    let s=1; for(let j=1;j<=M;j++){ const q=(i+j)%M; if(slab(q)){ s=sgOf(q); break; } } nextSg[i]=s;
+    let p=1; for(let j=1;j<=M;j++){ const q=(i-j+M)%M; if(slab(q)){ p=sgOf(q); break; } } prevSg[i]=p;
+  }
+  let y=y0, u=u0, refl=0;
+  const pts=[{zu:0, s:0, sg:1, y, refl, nd:1}];
+  for(let rt=0;rt<n;rt++){
+    let zr=0;
+    for(let i=0;i<M;i++){
+      const op=ops[i];
+      if(op.k==='m'){
+        if(isMir[op.ei]){ const zu=rt*rtLen+zr, s=sOf(zr);
+          pts.push({zu, s, sg:prevSg[i], y, refl, nd:-1, mir:1}); refl++; pts.push({zu, s, sg:nextSg[i], y, refl, nd:1, mir:2}); }
+      } else if(op.k==='l'){ u-=y/(plane==='T'?op.fT:op.fS); }
+      else {
+        const y1=y+(plane==='T'?op.dT:op.dS)*u;
+        if(Math.abs(y1)>ap){
+          const lim=y1>0?ap:-ap, t=(lim-y)/(y1-y), z1=zr+t*op.len;
+          const p={zu:rt*rtLen+z1, s:sOf(z1), sg:sgOf(i), y:lim, refl, nd:-1, rt:rt+1};
+          pts.push(p); return {pts, lost:p};
+        }
+        y=y1; zr+=op.len;
+        pts.push({zu:rt*rtLen+zr, s:sOf(zr), sg:sgOf(i), y, refl, nd:-1});
+      }
+    }
+  }
+  return {pts, lost:null};
+}
+
+/* ---- what the round-trip m says about ray behaviour ---- */
+function rayRegime(m){
+  if(!isFinite(m)) return {kind:'none'};
+  if(Math.abs(m)<1){
+    const th=Math.acos(m), f=th/(2*Math.PI);
+    let deg=null;
+    for(let q=1;q<=10&&!deg;q++){ const p=Math.round(q*f); if(p>0 && Math.abs(q*f-p)<0.01) deg={p,q}; }
+    return {kind:'stable', th, period:1/f, deg};
+  }
+  return {kind:'unstable', M:Math.abs(m)+Math.sqrt(m*m-1)};
+}
