+</head>
+<body>
+<div class="wrap">
+
+  <header class="page">
+    <p class="kicker">Laser physics — rate‑equation solver</p>
+    <h1>Three‑level vs four‑level lasing</h1>
+    <p class="lede">Set a pump power, watch the level populations and the cavity photon field solve themselves — as a steady state across a power sweep, and as a real time‑domain integration. Ruby (3‑level) and Nd:YAG (4‑level) are preloaded as realistic presets; every parameter is yours to change.</p>
+  </header>
+
+  <div class="tabs" role="tablist">
+    <div class="tab" id="tab-ruby" role="tab" aria-selected="true" onclick="selectSystem('ruby')">
+      Ruby <span class="sub">3‑level · 694 nm</span>
+    </div>
+    <div class="tab" id="tab-yag" role="tab" aria-selected="false" onclick="selectSystem('yag')">
+      Nd:YAG <span class="sub">4‑level · 1064 nm</span>
+    </div>
+  </div>
+
+  <section class="card">
+    <h2>Level scheme</h2>
+    <p class="section-note" id="scheme-note"></p>
+    <div class="diagram-row">
+      <svg id="level-diagram" class="chart" viewBox="0 0 340 280" xmlns="http://www.w3.org/2000/svg"></svg>
+      <div class="diagram-legend" id="scheme-legend"></div>
+    </div>
+  </section>
+
+  <section class="card">
+    <h2>Parameters</h2>
+    <p class="section-note">Cross section, lifetimes, cavity and pump properties. Values load from the preset; edit any field and every plot below recomputes.</p>
+    <div class="param-grid" id="param-grid"></div>
+  </section>
+
+  <section class="card">
+    <h2>Populations vs. pump power</h2>
+    <p class="section-note" id="pop-note"></p>
+    <label style="display:flex; align-items:flex-start; gap:9px; font-size:13px; color:var(--text-dim); margin:2px 0 14px; cursor:pointer;">
+      <input type="checkbox" id="chk-naive" onchange="onNaiveToggle()" style="margin-top:2px; accent-color:var(--sys);">
+      <span>Show the <strong style="color:var(--text); font-weight:600;">naive prediction</strong> — N₂ if stimulated emission never clamped the inversion (i.e. only solving dN₂/dt = 0 alone, ignoring the photon equation)</span>
+    </label>
+    <svg id="chart-pop" class="chart" viewBox="0 0 640 300" xmlns="http://www.w3.org/2000/svg"></svg>
+    <div class="chart-legend" id="pop-legend"></div>
+  </section>
+
+  <section class="card">
+    <h2>Output power vs. pump power</h2>
+    <p class="section-note">Power coupled out through the mirror by stimulated emission, once the gain clamps at threshold: <span style="white-space:nowrap">P<sub>out</sub> = (T<sub>oc</sub>/τ<sub>c</sub>)·S·V·hν</span>.</p>
+    <svg id="chart-power" class="chart" viewBox="0 0 640 300" xmlns="http://www.w3.org/2000/svg"></svg>
+    <div class="chart-legend" id="power-legend"></div>
+    <div class="readout-strip" id="threshold-readouts"></div>
+    <div id="warn-box"></div>
+  </section>
+
+  <section class="card">
+    <h2>Solving the rate equations in time</h2>
+    <p class="section-note">Pick a pump level and duration and integrate the coupled ODEs from a cold start (seeded by spontaneous emission). Above threshold, watch the upper‑level population and the photon field ring toward steady state in damped relaxation oscillations — extend the duration to confirm they settle.</p>
+    <div class="slider-row">
+      <div class="field">
+        <label>Pump level <span class="val" id="dyn-pump-val">—</span></label>
+        <input type="range" id="dyn-pump" min="0.1" max="2" step="0.05" value="1.5">
+      </div>
+      <div class="field">
+        <label>Duration <span class="val" id="dyn-dur-val">—</span></label>
+        <input type="range" id="dyn-dur" min="1" max="5" step="0.1" value="2">
+      </div>
+      <button class="run" onclick="runDynamics()">Solve →</button>
+    </div>
+    <div style="margin-top:16px;">
+      <p class="chart-title">Upper‑level population N₂(t)</p>
+      <svg id="chart-dyn-n2" class="chart" viewBox="0 0 640 220" xmlns="http://www.w3.org/2000/svg"></svg>
+    </div>
+    <div style="margin-top:18px;">
+      <p class="chart-title">Output power P<sub>out</sub>(t)</p>
+      <svg id="chart-dyn-p" class="chart" viewBox="0 0 640 220" xmlns="http://www.w3.org/2000/svg"></svg>
+    </div>
+  </section>
+
+  <section class="card">
+    <h2>The equations being solved</h2>
+    <footer class="eqbox" id="eqbox"></footer>
+  </section>
+
+  <p class="credit">Space‑independent rate‑equation model · densities in cm⁻³ · all curves computed client‑side</p>
+</div>
+
+<script>
+/* ---------------------------------------------------------------------
+   Constants
+--------------------------------------------------------------------- */
+const c_cm = 3e10;      // speed of light, cm/s
+const h_J  = 6.62607e-34; // Planck constant, J s
+const c_m  = 2.99792458e8;
+
+function photonEnergy(lambda_nm){ return h_J*c_m/(lambda_nm*1e-9); } // J
+
+/* ---------------------------------------------------------------------
+   Presets  (UI units — converted to SI/cgs in getParams())
+--------------------------------------------------------------------- */
+const PRESETS = {
+  ruby:{
+    label:'Ruby', sub:'Cr³⁺:Al₂O₃, 3‑level',
+    sigma1e20: 2.5,    // cm^2 x1e-20  (694.3 nm R-line)
+    tau2us:    3000,   // upper level (2E) lifetime, us  (~3 ms)
+    taucns:    30,     // cavity photon lifetime, ns
+    Nt1e19:    1.58,   // total Cr density, cm^-3 x1e19
+    V:         0.1,    // gain/mode volume, cm^3
+    Toc:       0.5,    // fraction of cavity loss that is useful output coupling
+    lambda:    694,    // laser wavelength, nm
+    lambdaP:   550,    // pump band wavelength, nm
+    etap:      0.5     // pump quantum efficiency
+  },
+  yag:{
+    label:'Nd:YAG', sub:'Nd³⁺:Y₃Al₅O₁₂, 4‑level',
+    sigma1e20: 28,     // cm^2 x1e-20  (1064 nm, 4F3/2->4I11/2)
+    tau2us:    230,    // upper level lifetime, us
+    taucns:    30,
+    Nt1e19:    13.8,   // total Nd density (~1 at.%), cm^-3 x1e19 (informational only)
+    V:         0.1,
+    Toc:       0.5,
+    lambda:    1064,
+    lambdaP:   808,
+    etap:      0.5
+  }
+};
+
+const FIELD_DEFS = [
+  {key:'sigma1e20', label:'Stimulated‑emission cross section σ', unit:'×10⁻²⁰ cm²', min:0.5, max:50, step:0.1},
+  {key:'tau2us',    label:'Upper‑level lifetime τ₂',              unit:'µs',        min:1,   max:5000, step:1},
+  {key:'taucns',    label:'Cavity photon lifetime τc',            unit:'ns',        min:1,   max:200, step:1},
+  {key:'Nt1e19',    label:'Total ion density N_t',                unit:'×10¹⁹ cm⁻³',min:0.1, max:50,  step:0.1},
+  {key:'V',         label:'Gain / mode volume V',                 unit:'cm³',       min:0.001,max:1,  step:0.001},
+  {key:'Toc',       label:'Output‑coupling fraction T_oc',        unit:'',          min:0.05,max:1,   step:0.01},
+  {key:'lambda',    label:'Laser wavelength λ',                   unit:'nm',        min:300, max:2000,step:1},
+  {key:'lambdaP',   label:'Pump wavelength λ_p',                  unit:'nm',        min:200, max:1000,step:1},
+  {key:'etap',      label:'Pump quantum efficiency η_p',          unit:'',          min:0.05,max:1,   step:0.01},
+];
+
+let state = { system:'ruby', params: Object.assign({}, PRESETS.ruby), showNaive:false };
+
+function onNaiveToggle(){
+  state.showNaive = document.getElementById('chk-naive').checked;
+  updateAll();
+}
+
+/* ---------------------------------------------------------------------
+   Physics — steady state (closed form solution of the rate equations)
+--------------------------------------------------------------------- */
+function getSI(p){
+  return {
+    sigma: p.sigma1e20*1e-20,
+    tau2:  p.tau2us*1e-6,
+    tauc:  p.taucns*1e-9,
+    Nt:    p.Nt1e19*1e19,
+    V:     p.V,
+    Toc:   p.Toc,
+    hv:    photonEnergy(p.lambda),
+    hvp:   photonEnergy(p.lambdaP),
+    etap:  p.etap
+  };
+}
+
+// Returns {N2, N0, S, Pout} for a given pump POWER (W)
+function steadyState(system, p, P){
+  const q = getSI(p);
+  const B = q.sigma*c_cm; // cm^3/s
+  if(system==='yag'){
+    const Rp = q.etap*P/(q.hvp*q.V);       // cm^-3 s^-1
+    const N2th = 1/(B*q.tauc);
+    const Rpth = N2th/q.tau2;
+    let N2,S;
+    if(Rp<=Rpth){ N2=Rp*q.tau2; S=0; }
+    else { N2=N2th; S=q.tauc*(Rp-Rpth); }
+    const N2naive = Rp*q.tau2; // what N2 would be if stimulated emission never clamped it
+    const Pout = (q.Toc/q.tauc)*S*q.V*q.hv;
+    return {N2, N0:null, S, Pout, N2th, N2naive, Pth: Rpth*q.hvp*q.V/q.etap, reachable:true};
+  } else {
+    const N2th_raw = q.Nt/2 + 1/(2*B*q.tauc);
+    const reachable = N2th_raw < q.Nt;
+    const N2th = Math.min(N2th_raw, q.Nt*0.999999);
+    const Wp = q.etap*P/(q.hvp*q.Nt*q.V);  // s^-1
+    let N2,S;
+    const N2below = Wp*q.Nt*q.tau2/(1+Wp*q.tau2); // no-lasing solution: pump saturation only, no stimulated emission
+    if(!reachable){
+      N2 = N2below; S=0;
+    } else {
+      const Wpth = N2th/(q.tau2*(q.Nt-N2th));
+      if(Wp<=Wpth){ N2=N2below; S=0; }
+      else { N2=N2th; S=q.tauc*(Wp*(q.Nt-N2th) - N2th/q.tau2); }
+    }
+    const N0 = q.Nt-N2;
+    const Pout = (q.Toc/q.tauc)*S*q.V*q.hv;
+    const Wpth = reachable ? N2th/(q.tau2*(q.Nt-N2th)) : Infinity;
+    const Pth = reachable ? Wpth*q.hvp*q.Nt*q.V/q.etap : Infinity;
+    return {N2, N0, S, Pout, N2th, N2naive:N2below, Pth, reachable};
+  }
+}
+
+function findThresholdPower(system, p){
+  const q = getSI(p);
+  const B = q.sigma*c_cm;
+  if(system==='yag'){
+    const N2th = 1/(B*q.tauc);
+    const Rpth = N2th/q.tau2;
+    return Rpth*q.hvp*q.V/q.etap;
+  } else {
+    const N2th_raw = q.Nt/2 + 1/(2*B*q.tauc);
+    if(N2th_raw>=q.Nt) return Infinity;
+    const Wpth = N2th_raw/(q.tau2*(q.Nt-N2th_raw));
+    return Wpth*q.hvp*q.Nt*q.V/q.etap;
+  }
+}
+
+/* ---------------------------------------------------------------------
+   Physics — time domain (RK4 integration of the actual rate equations)
+--------------------------------------------------------------------- */
+// Exponential (integrating-factor) scheme: the photon equation dS/dt = g*S + spont
+// is stiff (g can momentarily be >> 1/tauc during a relaxation spike), so S is advanced
+// analytically over each step assuming g is ~constant across it — unconditionally stable
+// for the fast variable, regardless of step size. N2 (the slow variable, set by tau2) is
+// then advanced explicitly using the step-averaged photon density. This is the standard
+// trick for integrating laser rate equations without an implicit solver.
+function integrate(system, p, pumpMultiple, durationInTau2){
+  const q = getSI(p);
+  const B = q.sigma*c_cm;
+  const Pth = findThresholdPower(system, p);
+  const P = pumpMultiple*Pth;
+  const pumpTerm = system==='yag'
+    ? q.etap*P/(q.hvp*q.V)
+    : q.etap*P/(q.hvp*q.Nt*q.V);
+  const beta = 3e-6; // fraction of spontaneous emission captured by the lasing mode (seed)
+
+  // Relaxation-oscillation angular frequency (small-signal estimate around the clamped
+  // steady state). This is NOT the same formula for both systems: perturbing N2 feeds the
+  // photon equation through d(N2)/dN2=1 for the 4-level system, but through d(2N2-Nt)/dN2=2
+  // for the 3-level system (and 3-level also gets extra linear damping from the pump acting
+  // on the depleting reservoir, Wp*(Nt-N2), which the 4-level's density-rate pump term Rp does
+  // not contribute). Using the 4-level formula for Ruby underestimates its true oscillation
+  // frequency by an order of magnitude and leaves the step far too coarse. General form:
+  //   C = kappa * sigma*c * S_ss      (S_ss = steady-state photon density at this pump level)
+  //   omega_R = sqrt(C / tauc)
+  // with kappa=1 (4-level) or kappa=2 (3-level).
+  const Sss = steadyState(system, p, P).S;
+  const kappa = system==='yag' ? 1 : 2;
+  const C = kappa*B*Sss;
+  const omegaR = C>0 ? Math.sqrt(C/q.tauc) : 0;
+  const TR = omegaR>0 ? 2*Math.PI/omegaR : Infinity;
+
+  let dt = Math.min(q.tau2/1500, q.tauc*5, TR/250);
+  let tmax = (durationInTau2||8)*q.tau2;
+  const HARD_CAP = 6000000;
+  let nSteps = Math.ceil(tmax/dt);
+  if(nSteps>HARD_CAP){ nSteps=HARD_CAP; tmax=nSteps*dt; } // shorten the shown duration, never coarsen dt
+
+  let N2=0, S=0;
+  // Sample density adapts to the same oscillation period so fast ringing at high pump ratios
+  // isn't visually aliased by too-coarse plotting.
+  const SAMPLES_PER_PERIOD = 16;
+  const MAX_SAMPLES = 6000;
+  let stride = omegaR>0 ? Math.max(1, Math.round((TR/SAMPLES_PER_PERIOD)/dt)) : Math.max(1, Math.floor(nSteps/600));
+  if(Math.ceil(nSteps/stride) > MAX_SAMPLES){ stride = Math.ceil(nSteps/MAX_SAMPLES); }
+  const tArr=[], N2Arr=[], PoutArr=[];
+
+  for(let i=0;i<nSteps;i++){
+    if(i%stride===0){
+      tArr.push(i*dt);
+      N2Arr.push(N2);
+      PoutArr.push((q.Toc/q.tauc)*S*q.V*q.hv);
+    }
+    const g = system==='yag' ? (B*N2 - 1/q.tauc) : (B*(2*N2-q.Nt) - 1/q.tauc);
+    const spontRate = beta*N2/q.tau2;
+    let S1;
+    if(Math.abs(g*dt) < 1e-8){ S1 = S + (g*S + spontRate)*dt; }
+    else { const eg = Math.exp(g*dt); S1 = S*eg + spontRate*(eg-1)/g; }
+    const Savg = 0.5*(S+S1);
+    const dN2dt = system==='yag'
+      ? pumpTerm - N2/q.tau2 - B*Savg*N2
+      : pumpTerm*(q.Nt-N2) - N2/q.tau2 - B*Savg*(2*N2-q.Nt);
+    N2 = Math.max(0, N2 + dt*dN2dt);
+    S  = Math.max(0, S1);
+  }
+  tArr.push(nSteps*dt); N2Arr.push(N2); PoutArr.push((q.Toc/q.tauc)*S*q.V*q.hv);
+  return {t:tArr, N2:N2Arr, Pout:PoutArr, Pth, P};
+}
+
+/* ---------------------------------------------------------------------
+   Chart rendering (hand-rolled SVG line charts)
+--------------------------------------------------------------------- */
+function fmt(v, digits=2){
+  if(v===0) return '0';
+  if(!isFinite(v)) return '∞';
+  const a = Math.abs(v);
+  if(a>=1e4 || a<1e-3) return v.toExponential(digits).replace('e+','e').replace('e-','e-');
+  return v.toPrecision(digits+1).replace(/\.?0+$/,'');
+}
+
+function lineChart(svgId, series, opts){
+  const svg = document.getElementById(svgId);
+  const W = opts.w||640, H = opts.h||300;
+  const m = {l:56, r:16, t:14, b:38};
+  const xMax = opts.xMax, yMax = opts.yMax || Math.max(1e-30, ...series.flatMap(s=>s.points.map(pt=>pt.y)));
+  const sx = x => m.l + (x/xMax)*(W-m.l-m.r);
+  const sy = y => H-m.b - (y/yMax)*(H-m.t-m.b);
+
+  let g = '';
+  // grid
+  const nY=4, nX=5;
+  for(let i=0;i<=nY;i++){
+    const y = m.t + i*(H-m.t-m.b)/nY;
+    g += `<line x1="${m.l}" y1="${y}" x2="${W-m.r}" y2="${y}" stroke="var(--grid)" stroke-width="1"/>`;
+    const val = yMax*(1-i/nY);
+    g += `<text x="${m.l-8}" y="${y+4}" font-size="10.5" text-anchor="end" fill="var(--text-dim)" font-family="var(--font-body)">${fmt(val)}</text>`;
+  }
+  for(let i=0;i<=nX;i++){
+    const x = m.l + i*(W-m.l-m.r)/nX;
+    const val = xMax*i/nX;
+    g += `<line x1="${x}" y1="${m.t}" x2="${x}" y2="${H-m.b}" stroke="var(--grid)" stroke-width="1"/>`;
+    g += `<text x="${x}" y="${H-m.b+16}" font-size="10.5" text-anchor="middle" fill="var(--text-dim)" font-family="var(--font-body)">${fmt(val)}</text>`;
+  }
+  g += `<text x="${(m.l+W-m.r)/2}" y="${H-4}" font-size="11" text-anchor="middle" fill="var(--text-dim)" font-family="var(--font-body)">${opts.xLabel||''}</text>`;
+  g += `<text x="14" y="${(m.t+H-m.b)/2}" font-size="11" text-anchor="middle" fill="var(--text-dim)" font-family="var(--font-body)" transform="rotate(-90 14 ${(m.t+H-m.b)/2})">${opts.yLabel||''}</text>`;
+
+  // axes
+  g += `<line x1="${m.l}" y1="${m.t}" x2="${m.l}" y2="${H-m.b}" stroke="var(--border)" stroke-width="1.3"/>`;
+  g += `<line x1="${m.l}" y1="${H-m.b}" x2="${W-m.r}" y2="${H-m.b}" stroke="var(--border)" stroke-width="1.3"/>`;
+
+  // threshold marker
+  if(opts.thresholdX!==undefined && isFinite(opts.thresholdX) && opts.thresholdX<=xMax){
+    const tx = sx(opts.thresholdX);
+    g += `<line x1="${tx}" y1="${m.t}" x2="${tx}" y2="${H-m.b}" stroke="var(--text-dim)" stroke-width="1" stroke-dasharray="3,3"/>`;
+    g += `<text x="${tx+4}" y="${m.t+11}" font-size="10.5" fill="var(--text-dim)" font-family="var(--font-body)">P_th</text>`;
+  }
+
+  // series
+  series.forEach(s=>{
+    if(!s.points.length) return;
+    const d = s.points.map((pt,i)=> (i===0?'M':'L')+sx(pt.x).toFixed(2)+','+sy(Math.max(0,pt.y)).toFixed(2)).join(' ');
+    g += `<path d="${d}" fill="none" stroke="${s.color}" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" ${s.dashed?'stroke-dasharray="5,4"':''}/>`;
+  });
+
+  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
+  svg.innerHTML = g;
+}
+
+function legendHTML(id, items){
+  document.getElementById(id).innerHTML = items.map(it=>
+    `<span><i style="background:${it.color}"></i>${it.name}</span>`).join('');
+}
+
+/* ---------------------------------------------------------------------
+   Level diagrams
+--------------------------------------------------------------------- */
+function drawDiagram(system){
+  const svg = document.getElementById('level-diagram');
+  const sysColor = system==='ruby' ? 'var(--ruby)' : 'var(--yag)';
+  let s = '';
+  const W=340,H=280, x0=60, x1=280;
+  function level(y,label,dashed){
+    s += `<line x1="${x0}" y1="${y}" x2="${x1}" y2="${y}" stroke="var(--text)" stroke-width="${dashed?1.4:2.2}" ${dashed?'stroke-dasharray="4,3"':''}/>`;
+    s += `<text x="${x1+8}" y="${y+4}" font-size="12" fill="var(--text-dim)" font-family="var(--font-body)">${label}</text>`;
+  }
+  function arrow(x,y1,y2,color,dashed,wiggle){
+    const mid = (y1+y2)/2;
+    if(wiggle){
+      s += `<path d="M ${x} ${y1} q -10 ${(y2-y1)*0.25} 0 ${(y2-y1)*0.5} q 10 ${(y2-y1)*0.25} 0 ${(y2-y1)*0.5}" fill="none" stroke="${color}" stroke-width="2" ${dashed?'stroke-dasharray="3,3"':''}/>`;
+    } else {
+      s += `<line x1="${x}" y1="${y1}" x2="${x}" y2="${y2}" stroke="${color}" stroke-width="2.2" ${dashed?'stroke-dasharray="3,3"':''}/>`;
+    }
+    const dir = y2>y1?1:-1;
+    s += `<path d="M ${x-4} ${y2-dir*7} L ${x} ${y2} L ${x+4} ${y2-dir*7}" fill="none" stroke="${color}" stroke-width="2.2"/>`;
+  }
+  if(system==='ruby'){
+    const yGround=250, yUpper=110, yBand=40;
+    level(yGround,'ground N₀');
+    level(yUpper,'metastable N₂ (upper laser level)');
+    level(yBand,'pump band',true);
+    arrow(120, yGround, yBand, sysColor, false, false);
+    s += `<text x="126" y="${(yGround+yBand)/2}" font-size="11" fill="${sysColor}" font-family="var(--font-body)">pump</text>`;
+    arrow(160, yBand, yUpper, 'var(--text-dim)', true, true);
+    s += `<text x="166" y="${(yBand+yUpper)/2}" font-size="10.5" fill="var(--text-dim)" font-family="var(--font-body)">fast decay</text>`;
+    arrow(220, yUpper, yGround, 'var(--amber)', false, false);
+    s += `<text x="226" y="${(yUpper+yGround)/2}" font-size="11" fill="var(--amber)" font-family="var(--font-body)">694 nm</text>`;
+  } else {
+    const yGround=250, yLower=196, yUpper=90, yBand=40;
+    level(yGround,'ground N₀ (reservoir)');
+    level(yLower,'lower laser level N₁',true);
+    level(yUpper,'upper laser level N₂');
+    level(yBand,'pump band',true);
+    arrow(110, yGround, yBand, sysColor, false, false);
+    s += `<text x="116" y="${(yGround+yBand)/2}" font-size="11" fill="${sysColor}" font-family="var(--font-body)">pump</text>`;
+    arrow(150, yBand, yUpper, 'var(--text-dim)', true, true);
+    s += `<text x="156" y="${(yBand+yUpper)/2-8}" font-size="10.5" fill="var(--text-dim)" font-family="var(--font-body)">fast decay</text>`;
+    arrow(215, yUpper, yLower, 'var(--amber)', false, false);
+    s += `<text x="221" y="${(yUpper+yLower)/2}" font-size="11" fill="var(--amber)" font-family="var(--font-body)">1064 nm</text>`;
+    arrow(255, yLower, yGround, 'var(--text-dim)', true, true);
+    s += `<text x="196" y="${yGround+18}" font-size="10.5" fill="var(--text-dim)" font-family="var(--font-body)">fast decay</text>`;
+  }
+  svg.setAttribute('viewBox',`0 0 ${W} ${H}`);
+  svg.innerHTML = s;
+
+  document.getElementById('scheme-note').textContent = system==='ruby'
+    ? 'Ruby lases on a transition that terminates on the ground state itself. The pump has to empty more than half the ground population before gain exceeds loss — the defining hardship of a 3‑level laser.'
+    : 'Nd:YAG lases between two excited levels, and the lower one empties itself almost instantly to the ground reservoir. Population inversion needs only a small fraction of the ion density — the defining advantage of a 4‑level laser.';
+
+  document.getElementById('scheme-legend').innerHTML = system==='ruby'
+    ? `<p><strong>3‑level scheme.</strong> Broadband pump light lifts Cr³⁺ ions from the ground state N₀ into a short‑lived pump band, which decays fast (non‑radiatively) into the metastable ²E level N₂ (τ₂ ≈ 3 ms). Laser action is the N₂ → N₀ transition at 694.3 nm — so the lower laser level is the ground state, and stays populated until pumped away.</p>
+       <p>Threshold requires N₂ > N_t/2 + loss term: at least half the ions must be excited before gain exists at all.</p>`
+    : `<p><strong>4‑level scheme.</strong> Diode light near 808 nm pumps Nd³⁺ ions into a pump band that decays fast into the upper laser level N₂ (τ₂ ≈ 230 µs). Laser action is N₂ → N₁ at 1064 nm, and N₁ empties to the ground reservoir almost instantly — so N₁ stays essentially empty.</p>
+       <p>Threshold only requires N₂ to reach a small clamp value set by cavity loss, not a macroscopic fraction of N_t — hence the much lower threshold.</p>`;
+}
+
+/* ---------------------------------------------------------------------
+   UI wiring
+--------------------------------------------------------------------- */
+function buildParamGrid(){
+  const grid = document.getElementById('param-grid');
+  grid.innerHTML = FIELD_DEFS.map(f=>{
+    const v = state.params[f.key];
+    return `<div class="field">
+      <label>${f.label} <span class="val" id="lbl-${f.key}">${v}<span class="unit"> ${f.unit}</span></span></label>
+      <input type="range" id="rng-${f.key}" min="${f.min}" max="${f.max}" step="${f.step}" value="${v}"
+        oninput="onParamChange('${f.key}', this.value)">
+    </div>`;
+  }).join('');
+}
+
+function onParamChange(key, value){
+  state.params[key] = parseFloat(value);
+  document.getElementById('lbl-'+key).innerHTML = fmt(state.params[key],3)+'<span class="unit"> '+FIELD_DEFS.find(f=>f.key===key).unit+'</span>';
+  updateAll();
+}
+
+function selectSystem(sys){
+  state.system = sys;
+  state.params = Object.assign({}, PRESETS[sys]);
+  document.getElementById('tab-ruby').setAttribute('aria-selected', sys==='ruby');
+  document.getElementById('tab-yag').setAttribute('aria-selected', sys==='yag');
+  document.documentElement.style.setProperty('--sys', sys==='ruby'?'var(--ruby)':'var(--yag)');
+  document.documentElement.style.setProperty('--sys-soft', sys==='ruby'?'var(--ruby-soft)':'var(--yag-soft)');
+  buildParamGrid();
+  drawDiagram(sys);
+  buildEquationBox(sys);
+  document.getElementById('chart-dyn-n2').innerHTML='';
+  document.getElementById('chart-dyn-p').innerHTML='';
+  configureDynSliders(sys);
+  updateAll();
+}
+
+// Ruby settles within microseconds of crossing threshold, so a short window and a modest
+// pump range are enough; Nd:YAG rings for longer and is worth exploring further above threshold.
+const DYN_RANGES = {
+  ruby:{pumpMax:2, pumpVal:1.5, durMin:1, durMax:5,  durVal:2, durStep:0.1},
+  yag: {pumpMax:6, pumpVal:2.5, durMin:1, durMax:20, durVal:8, durStep:0.5}
+};
+function configureDynSliders(sys){
+  const r = DYN_RANGES[sys];
+  const pump = document.getElementById('dyn-pump');
+  const dur  = document.getElementById('dyn-dur');
+  pump.max = r.pumpMax; pump.value = r.pumpVal;
+  dur.min = r.durMin; dur.max = r.durMax; dur.step = r.durStep; dur.value = r.durVal;
+  document.getElementById('dyn-pump-val').textContent = pump.value+'× P_th';
+  document.getElementById('dyn-dur-val').textContent = dur.value+' × τ₂';
+}
+
+function buildEquationBox(sys){
+  const box = document.getElementById('eqbox');
+  if(sys==='yag'){
+    box.innerHTML = `
+      <div class="eq">dN₂/dt = R_p − N₂/τ₂ − σcS·N₂</div>
+      <div class="eq">dS/dt = σcS·N₂ − S/τ_c</div>
+      <p>N₂: upper‑level density (cm⁻³). S: photon density in the cavity mode (cm⁻³). R_p = η_p·P/(hν_p·V): pump rate density. Steady state above threshold clamps N₂ at N₂,th = 1/(σcτ_c), independent of pump power — all extra pumping goes into S instead.</p>`;
+  } else {
+    box.innerHTML = `
+      <div class="eq">dN₂/dt = W_p·(N_t−N₂) − N₂/τ₂ − σcS·(2N₂−N_t)</div>
+      <div class="eq">dS/dt = σcS·(2N₂−N_t) − S/τ_c</div>
+      <p>N₂: metastable‑level density; N₀ = N_t−N₂ is the ground‑state reservoir being depleted. W_p = η_p·P/(hν_p·N_t·V): pump rate constant per ion. Threshold clamps N₂ at N_t/2 + 1/(2σcτ_c) — a macroscopic fraction of the whole ion population.</p>`;
+  }
+}
+
+function updateAll(){
+  const sys = state.system, p = state.params;
+  const Pth = findThresholdPower(sys, p);
+  const PmaxAuto = isFinite(Pth) ? Pth*4.5 : (sys==='ruby'?1000:5);
+  const N = 140;
+  const popPts2 = [], popPts0=[], powerPts=[], popPtsNaive=[];
+  for(let i=0;i<=N;i++){
+    const P = PmaxAuto*i/N;
+    const r = steadyState(sys, p, P);
+    popPts2.push({x:P, y:r.N2});
+    if(sys==='ruby') popPts0.push({x:P, y:r.N0});
+    powerPts.push({x:P, y:r.Pout*1000}); // mW
+    popPtsNaive.push({x:P, y:r.N2naive});
+  }
+  const q = getSI(p);
+
+  const colRuby = getComputedStyle(document.documentElement).getPropertyValue('--ruby').trim();
+  const colYag  = getComputedStyle(document.documentElement).getPropertyValue('--yag').trim();
+  const colAmber= getComputedStyle(document.documentElement).getPropertyValue('--amber').trim();
+  const colDim  = getComputedStyle(document.documentElement).getPropertyValue('--text-dim').trim();
+  const sysCol = sys==='ruby'? colRuby : colYag;
+
+  const popSeries = [{name:'N₂ upper level', color:sysCol, points:popPts2}];
+  if(sys==='ruby') popSeries.push({name:'N₀ ground level', color:colDim, points:popPts0, dashed:true});
+  if(state.showNaive) popSeries.push({name:'naive N₂ (unclamped)', color:colAmber, points:popPtsNaive, dashed:true});
+
+  const yMaxPop = sys==='ruby' ? q.Nt*1.05 : Math.max(...popPts2.map(d=>d.y), ...popPtsNaive.map(d=>d.y))*1.2 || 1;
+  lineChart('chart-pop', popSeries, {xMax:PmaxAuto, yMax:yMaxPop, xLabel:'Pump power (W)', yLabel:'density (cm⁻³)', thresholdX:Pth});
+  legendHTML('pop-legend', popSeries.map(s=>({name:s.name, color:s.color})));
+  document.getElementById('pop-note').textContent = sys==='ruby'
+    ? 'N₂ climbs, then pins at the clamp value once lasing starts (dashed threshold line) — note it sits near half of N_t. N₀ mirrors it from above.'
+    : 'N₂ climbs, then clamps at a tiny fraction of the ion density once lasing starts (dashed threshold line) — the hallmark of a 4‑level laser.';
+
+  lineChart('chart-power', [{name:'P_out', color:colAmber, points:powerPts}], {xMax:PmaxAuto, xLabel:'Pump power (W)', yLabel:'P_out (mW)', thresholdX:Pth});
+  legendHTML('power-legend', [{name:'Output power (mW)', color:colAmber}]);
+
+  const readouts = document.getElementById('threshold-readouts');
+  const slopeEff = (()=>{
+    const P2 = PmaxAuto, r2 = steadyState(sys,p,P2);
+    if(!isFinite(Pth) || P2<=Pth) return 0;
+    return (r2.Pout)/(P2-Pth)*100;
+  })();
+  const N2thDisplay = isFinite(Pth) ? steadyState(sys,p,Pth).N2th : steadyState(sys,p,0).N2th;
+  readouts.innerHTML = `
+    <div class="readout"><div class="k">Threshold pump power</div><div class="v">${isFinite(Pth)?fmt(Pth,3):'—'} <span class="u">W</span></div></div>
+    <div class="readout"><div class="k">N₂ at threshold</div><div class="v">${isFinite(Pth)?fmt(N2thDisplay,3):'—'} <span class="u">cm⁻³</span></div></div>
+    <div class="readout"><div class="k">Slope efficiency</div><div class="v">${isFinite(Pth)?fmt(slopeEff,3):'—'} <span class="u">%</span></div></div>
+  `;
+
+  const warnBox = document.getElementById('warn-box');
+  if(!isFinite(Pth)){
+    warnBox.innerHTML = `<div class="warn">Threshold is unreachable with these parameters: the required inversion N₂,th ≥ N_t. Increase the cross section σ, lengthen τ_c (lower cavity loss), or raise the cavity photon lifetime to bring the threshold below N_t.</div>`;
+  } else {
+    warnBox.innerHTML = '';
+  }
+
+  document.getElementById('dyn-pump-val').textContent = document.getElementById('dyn-pump').value + '× P_th';
+}
+
+function runDynamics(){
+  const sys = state.system, p = state.params;
+  const mult = parseFloat(document.getElementById('dyn-pump').value);
+  const dur = parseFloat(document.getElementById('dyn-dur').value);
+  document.getElementById('dyn-pump-val').textContent = mult.toFixed(2)+'× P_th';
+  document.getElementById('dyn-dur-val').textContent = dur.toFixed(0)+' × τ₂';
+  if(!isFinite(findThresholdPower(sys,p))){
+    document.getElementById('chart-dyn-n2').innerHTML = '';
+    document.getElementById('chart-dyn-p').innerHTML = '';
+    return;
+  }
+  const res = integrate(sys, p, mult, dur);
+  const colRuby = getComputedStyle(document.documentElement).getPropertyValue('--ruby').trim();
+  const colYag  = getComputedStyle(document.documentElement).getPropertyValue('--yag').trim();
+  const colAmber= getComputedStyle(document.documentElement).getPropertyValue('--amber').trim();
+  const sysCol = sys==='ruby'? colRuby : colYag;
+
+  const tMaxPlot = res.t[res.t.length-1];
+  const n2pts = res.t.map((t,i)=>({x:t*1e3, y:res.N2[i]})); // ms
+  const ppts  = res.t.map((t,i)=>({x:t*1e3, y:res.Pout[i]*1000})); // mW
+
+  lineChart('chart-dyn-n2', [{name:'N₂(t)', color:sysCol, points:n2pts}],
+    {h:220, xMax:tMaxPlot*1e3, xLabel:'time (ms)', yLabel:'N₂ (cm⁻³)', thresholdX:undefined});
+  lineChart('chart-dyn-p', [{name:'P_out(t)', color:colAmber, points:ppts}],
+    {h:220, xMax:tMaxPlot*1e3, xLabel:'time (ms)', yLabel:'P_out (mW)'});
+}
+
+document.getElementById('dyn-pump').addEventListener('input', ()=>{
+  document.getElementById('dyn-pump-val').textContent = document.getElementById('dyn-pump').value+'× P_th';
+});
+document.getElementById('dyn-dur').addEventListener('input', ()=>{
+  document.getElementById('dyn-dur-val').textContent = document.getElementById('dyn-dur').value+' × τ₂';
+});
+
+/* init */
+document.documentElement.style.setProperty('--sys','var(--ruby)');
+document.documentElement.style.setProperty('--sys-soft','var(--ruby-soft)');
+selectSystem('ruby');
+runDynamics();
+</script>
+</body>
+</html>
