From 279bcc604b5d1ba3720717679e2742c7696802cb Mon Sep 17 00:00:00 2001
From: Mikko Huttunen <mikko@example.com>
Date: Mon, 28 Sep 2026 12:04:05 +0000
Subject: [PATCH] FTIR explorer: move controls to left column, shrink figure

- Wrap Configuration panel and bench diagram in a two-column flex
  layout (.layout > .controls-col + .figure-col)
- Controls column fixed at ~300px, figure column at ~380px so the
  diagram renders smaller than before
- Stacks back to a single column under 720px viewport width
- Tightened .row label/input flex rules so sliders fit the
  narrower controls column
---
 fys240-optics/ftir_explorer.html | 110 +++++++++++++++++++------------
 1 file changed, 69 insertions(+), 41 deletions(-)

diff --git a/fys240-optics/ftir_explorer.html b/fys240-optics/ftir_explorer.html
index 9b66ea4..a164b9c 100644
--- a/fys240-optics/ftir_explorer.html
+++ b/fys240-optics/ftir_explorer.html
@@ -89,6 +89,26 @@
     margin: 0 0 18px;
     max-width: 68ch;
   }
+  .layout {
+    display: flex;
+    align-items: flex-start;
+    gap: 22px;
+    flex-wrap: wrap;
+  }
+  .controls-col {
+    flex: 0 0 300px;
+    min-width: 260px;
+  }
+  .controls-col .panel { margin-top: 0; }
+  .figure-col {
+    flex: 0 0 380px;
+    min-width: 260px;
+  }
+  @media (max-width: 720px) {
+    .layout { flex-direction: column; }
+    .controls-col, .figure-col { flex: 1 1 auto; width: 100%; }
+  }
+
   .bench {
     background: transparent;
     border-radius: 14px;
@@ -172,7 +192,9 @@
     font-size: 0.85rem;
     color: var(--ink-muted);
     min-width: 108px;
+    flex: 1 1 100%;
   }
+  .row input[type="range"] { min-width: 0; }
   .row .val {
     font-family: "IBM Plex Mono", ui-monospace, monospace;
     font-size: 0.85rem;
@@ -296,52 +318,58 @@
     <p>Drag the incidence angle past the critical angle at a glass&nbsp;→&nbsp;air interface and the ray reflects entirely — but bring a second glass block close enough and light tunnels across the gap as an evanescent wave. That's frustrated total internal reflection (FTIR).</p>
   </header>
 
