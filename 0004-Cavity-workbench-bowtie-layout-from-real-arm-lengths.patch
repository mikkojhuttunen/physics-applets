+/* ---- astigmatism: mode ellipticity in the crystal, and the fold angle that removes it ---- */
+// Compensated means both planes see the same cavity: equal round-trip m, hence equal stability
+// ranges and a round beam in the arms. The waist ratio in the crystal alone is a weak indicator.
+function astigState(st){
+  const gi=st.els.findIndex(e=>e.type==='gain'); if(gi<0) return null;
+  const g=st.els[gi], th=thermalF(g,st).f, {ops,fwdEnd}=buildSeq(st,th), M=roundTrip(ops);
+  const eT=eigenQ(M.T), eS=eigenQ(M.S); if(!eT.stable||!eS.stable) return null;
+  const r=propagate(ops,fwdEnd,eT.q,eS.q,g.lamC*1e-9,40).rec[gi];
+  return {mT:eT.m, mS:eS.m, ratio:r.wTm/r.wSm};
+}
+function compensateAstig(st){
+  const cm=st.els.filter(e=>e.type==='mirror_curved');
+  if(!cm.length) return {err:'There is no curved mirror to tilt.'};
+  if(!st.els.some(e=>e.type==='gain')) return {err:'Add a gain crystal first.'};
+  const s2=JSON.parse(JSON.stringify(st)); let best=null;
+  for(let a=0;a<=30.0001;a+=0.05){
+    s2.els.forEach(e=>{ if(e.type==='mirror_curved') e.aoi=a; });
+    const r=astigState(s2); if(r==null) continue;
+    const c=Math.abs(r.mT-r.mS); if(!best||c<best.c-1e-9) best={a,c};
+  }
+  if(!best) return {err:'No incidence angle between 0° and 30° gives a stable cavity.'};
+  const th=Math.round(best.a*10)/10; cm.forEach(e=>e.aoi=th);
+  const g=st.els.find(e=>e.type==='gain'), dl=g.brew ? g.L*(g.n*g.n-1)/(g.n**3) : 0, Rm=cm.reduce((p,e)=>p+e.R,0)/cm.length;
+  let est=null;
+  if(cm.length===2 && dl>0){ let lo=0, hi=Math.PI/4; for(let k=0;k<60;k++){ const m=(lo+hi)/2; if(Rm*Math.sin(m)*Math.tan(m)<dl) lo=m; else hi=m; } est=lo*180/Math.PI; }
+  return Object.assign({theta:th, est, dl, Rm, n:cm.length}, astigState(st));
+}
